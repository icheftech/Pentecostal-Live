# Pentecostal Live — nginx-rtmp ingest (example)
#
# Requires the nginx-rtmp-module (e.g. the tiangolo/nginx-rtmp image or
# `nginx` built with --add-module=nginx-rtmp-module).
#
# Flow: OBS publishes to rtmp://<this-host>:1935/live/<ingest_key>.
# The media-server's ffmpeg relay pulls from the same URL and fans out to the
# platforms + writes HLS. See infra/nginx/README.md.

worker_processes auto;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # --- on_publish callback (PLACEHOLDER) -------------------------
            # When an encoder starts publishing, nginx-rtmp POSTs
            # form-encoded params (app, name, addr, ...) to this URL; `name`
            # is the per-stream ingest key generated by the API on
            # POST /v1/streams/{id}/start. The API endpoint that validates
            # the key does not exist yet — uncomment once it does. Returning
            # non-2xx rejects the publish.
            #
            # on_publish http://api:8000/v1/ingest/on-publish;
            # on_publish_done http://api:8000/v1/ingest/on-publish-done;

            # Only local services (the media-server relay) may play/pull.
            allow play 127.0.0.1;
            allow play 172.16.0.0/12;   # docker networks
            deny play all;
        }
    }
}

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;

    server {
        listen 8080;

        # HLS output written by the media-server's ffmpeg relay
        # (PENTECOSTAL_LIVE_HLS_ROOT, one subdirectory per stream id).
        location /hls/ {
            alias /var/pentecostal-live/hls/;
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            add_header Cache-Control no-cache;
            add_header Access-Control-Allow-Origin *;
        }

        location /healthz {
            return 200 "ok\n";
        }
    }
}
